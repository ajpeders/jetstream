{
  "name": "jetstream-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:theme && vite build && vite build --config vite.public.config.js",
    "build:theme": "tailwindcss -i ./src/jetstream-theme.css -o ./static/jetstream-theme.css --minify",
    "dev": "vite --host 0.0.0.0",
    "build:public": "vite build --config vite.public.config.js",
    "watch:public": "vite build --watch --config vite.public.config.js",
    "watch": "vite build --watch --mode development",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "daisyui": "^5.7.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0",
    "vite": "^6.0.0"
  }
}
