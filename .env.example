JETSTREAM_DOMAIN=live.thelunadog.com
JETSTREAM_MEDIA_PATH=/home/ween/share/media

# Viewer auth — anyone allowed to watch. Friends use invite tokens minted
# from the admin page; this basicauth pair is a backup for tooling that
# can't carry the lt cookie (rare). Comma-separated user:apr1-hash entries,
# double every $ for compose interpolation.
# Generate hash: openssl passwd -apr1 <password>
JETSTREAM_VIEWER_AUTH=goon:$$apr1$$replace$$with-viewer-hash

# Admin basic auth — protects /admin and /admin/api/*. Friends use invite
# tokens minted from the admin page; viewer routes (/, /api/status, /hls/*)
# are gated server-side by token cookies, not basic auth.
JETSTREAM_ADMIN_AUTH=admin:$$apr1$$replace$$with-admin-hash

# Hardware encoder. Everything OFF by default → libx264 CPU path, works
# on any host. The right accelerator is picked by an overlay compose file
# applied via COMPOSE_FILE in services/.env (bin/install handles this):
#   - NVIDIA host → services/jetstream/docker-compose.gpu.yml sets USE_NVENC=1
#   - Intel iGPU → set USE_VAAPI=1 here (no overlay; /dev/dri is always mounted)
USE_VAAPI=0
VAAPI_DEVICE=/dev/dri/renderD128

# Hardware decoding via VAAPI. Pinned off — on Intel UHD 630 the chain
# produces 100x-oversized HLS segments due to a muxer/PTS interaction
# (see ROADMAP). CPU decode handles everything fine. NVDEC is wired in
# through USE_NVENC and doesn't need this flag.
USE_VAAPI_DECODE=0

# Encoding quality (CQP rate control on UHD 630 / libx264 elsewhere)
VIDEO_BITRATE=5M
AUDIO_BITRATE=160k

# Output cap. 1080p default; set 2160 for 4K passthrough on capable bandwidth.
# Source-bounded — smaller sources don't get pointlessly upscaled.
TARGET_HEIGHT=1080

# HLS segment timing. 4×6 = 24s playlist; lower segment time cuts the live-edge
# sync floor (1s = ~1.7s sync) at the cost of ~4x more files / requests.
HLS_SEG_TIME=4
HLS_LIST_SIZE=6
