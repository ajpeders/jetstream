/* The config the Angular builder compiles against. Kept separate from the
   base so `files` names a real entry point — an empty list is a hard error. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": []
  },
  "files": ["src/admin-app/main.ts"],
  "include": ["src/admin-app/**/*.d.ts"]
}
