## jetstream front-proxy.
## Serves /hls/* directly off the shared tmpfs (faster than routing through
## Flask), gates access via auth_request to the Flask app's /api/_authcheck,
## proxies everything else through to the Flask app. Same template runs in
## front of both `jetstream` (prod) and `jetstream-dev` (dev) — only the
## upstream backend changes via $JETSTREAM_BACKEND.

upstream jetstream_backend {
  server ${JETSTREAM_BACKEND}:8080;
  keepalive 16;
}

server {
  listen 80;
  server_name _;

  # Generous request body — admin can POST URL queues, settings, etc.
  client_max_body_size 8m;

  # Recover the real client IP from Traefik's X-Forwarded-For so the /hls/ LAN
  # bypass below can gate on it. Only the docker `web` subnet (where Traefik
  # talks to us) is trusted; recursive walk means a spoofed XFF from a remote
  # client can't make them look local — Traefik appends the true peer last.
  set_real_ip_from 172.24.0.0/16;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  # /hls/vod/* — per-user private VOD sessions (v2). Longest-prefix match
  # wins, so this beats the /hls/ block below. Deliberately NO LAN bypass:
  # a VOD stream belongs to exactly one logged-in user, and the Apple-TV
  # AirPlay rationale doesn't apply. Ownership (session id in the path vs
  # the js_user cookie) is checked by Flask via X-Original-URI.
  location /hls/vod/ {
    auth_request /__authcheck_vod;

    alias /hls/vod/;

    add_header Cache-Control "no-store" always;
    add_header Access-Control-Allow-Origin "*" always;
    sendfile on;
    tcp_nopush on;
  }

  location = /__authcheck_vod {
    internal;
    proxy_pass http://jetstream_backend/api/_authcheck_vod;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
    # The original path carries the VOD session id — Flask needs it for the
    # per-user ownership check (auth_request rewrites the URI otherwise).
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header User-Agent $http_user_agent;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
  }

  # /hls/* — static manifests and segments. Auth via subrequest to Flask;
  # if the viewer's token cookie is invalid (and we're not in public mode),
  # nginx rejects with 401 here without ever reading the file.
  location /hls/ {
    # LAN bypass: clients on the private network (e.g. the living-room Apple TV
    # AirPlaying the stream) skip the token entirely — AirPlay has the TV fetch
    # the HLS itself and it can't carry the viewer cookie. `satisfy any` means a
    # private-range client is allowed OR a valid token passes; remote/public
    # friends fall through to the cookie check unchanged.
    satisfy any;
    allow 127.0.0.1;
    allow 10.0.0.0/8;        # LAN + WireGuard VPN (10.8.0.0/24)
    allow 192.168.0.0/16;    # LAN (living-room Apple TV @ 192.168.0.39)
    deny all;                # everyone else (incl. Traefik's own IP if XFF ever
    auth_request /__authcheck;   # goes missing) falls through to the token check

    alias /hls/;

    # Manifests roll every segment-time; segments are small. No-store keeps
    # CDN caches and browser caches honest.
    add_header Cache-Control "no-store" always;

    # Allow Hls.js to read across origins if a viewer ever embeds the
    # stream from a different host. Doesn't widen attack surface — auth
    # already gated by the cookie.
    add_header Access-Control-Allow-Origin "*" always;

    # Use sendfile for the segment transfer — copies bytes from tmpfs to
    # the socket without touching userland.
    sendfile on;
    tcp_nopush on;
  }

  # Internal — not reachable from outside. nginx hits this for every /hls/*
  # request and only allows the file through on 2xx. Doubles as the viewer-
  # tracking hook: Flask's _authcheck calls _track_viewer() so the active
  # viewers list / history keep working even though /hls/* itself never
  # touches Python anymore.
  location = /__authcheck {
    internal;
    proxy_pass http://jetstream_backend/api/_authcheck;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    # Pass cookies along so Flask sees the viewer's token.
    proxy_set_header Cookie $http_cookie;
    # Forward the real client IP so _track_viewer logs the right thing —
    # without these, Flask sees nginx's container IP for every viewer.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header User-Agent $http_user_agent;
    # Keep-alive to the Flask upstream.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
  }

  # Everything else — Flask proxy. Includes the viewer page, admin page,
  # /api/*, /admin/api/*, etc.
  location / {
    proxy_pass http://jetstream_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    # Flask /api/status etc. are short-lived; admin URL resolution can be
    # 30-60s for some yt-dlp paths. 120s window matches Flask's gunicorn
    # --timeout 120.
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    # No buffering — preserves any future SSE / long-poll endpoints.
    proxy_buffering off;
  }
}
